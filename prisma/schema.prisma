  phoneCodeExpires          DateTime?
  emailVerificationAttempts Int       @default(0)
  phoneVerificationAttempts Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime
  users                     users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailVerified])
  @@index([phoneVerified])
  @@index([userId])
}

