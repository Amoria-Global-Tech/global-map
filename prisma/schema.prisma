generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String?
  description String?
  price       Float?
  imageUrl    String?   @map("image_url")
  category    String?
  isAvailable Boolean?  @map("is_available")
  siteUrl     String?   @map("site_url")
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)

  @@map("products")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?
  price       Decimal? @db.Decimal(10, 2)
  category    String?  @db.VarChar(100)
  image_url   String?  @db.VarChar(512)
  isActive    Boolean? @default(true) @map("is_active")
  status      String?
  icon        String?
  features    String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @db.Timestamp(6)

  @@map("services")
}

model Partner {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(150)
  description   String?
  logoUrl       String?  @map("logo_url") @db.VarChar(512)
  website_url   String?  @db.VarChar(255)
  contact_email String?  @db.VarChar(150)
  is_visible    Boolean? @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @db.Timestamp(6)

  @@map("partners")
}

model Contact {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  name        String?
  email       String?
  phoneNumber String?   @map("phone_number")
  subject     String?
  message     String?
  isResolved  Boolean?  @map("is_resolved")
  admin_reply String?
  replied_at  DateTime? @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id])

  @@index([isResolved])
  @@index([user_id])
  @@map("contact_us")
}

model VisitorTracking {
  id        Int       @id @default(autoincrement())
  ipAddress String?
  location  Json?
  country   String?
  city      String?
  region    String?
  timezone  String?
  userAgent String?
  pageUrl   String?
  referrer  String?
  sessionId String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)

  @@map("visitor_tracking")
}

model NewsUpdate {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  excerpt     String?   @db.VarChar(500)
  content     String?
  imageUrl    String?   @map("image_url") @db.VarChar(512)
  category    String    @db.VarChar(100)
  tags        String[]  @default([])
  author      String?   @db.VarChar(150)
  isPublished Boolean   @default(false) @map("is_published")
  isFeatured  Boolean   @default(false) @map("is_featured")
  views       Int       @default(0)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([publishedAt])
  @@map("news_updates")
}

model activity_logs {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  action        String?
  resource_type String?
  resource_id   String?
  ip_address    String?
  user_agent    String?
  details       Json?
  status        String?
  error_message String?
  duration_ms   Int?
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime? @db.Timestamptz(6)
  users         users?    @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([resource_type])
  @@index([user_id])
}

model address_unlock_refunds {
  id                       Int                      @id @default(autoincrement())
  createdAt                DateTime                 @default(now())
  processedAt              DateTime?
  refundAmountRwf          Decimal                  @db.Decimal(10, 2)
  refundMethod             String?
  refundReference          String?
  refundStatus             String                   @default("pending")
  requestedAt              DateTime                 @default(now())
  unlockId                 String
  userId                   Int
  property_address_unlocks property_address_unlocks @relation(fields: [unlockId], references: [unlockId], onDelete: Cascade)
  users                    users                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, refundStatus])
}

model admin_audit_logs {
  id           String        @id
  adminId      Int?
  action       String
  category     AuditCategory
  resource     String
  resourceId   String?
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  sessionId    String?
  success      Boolean       @default(true)
  errorMessage String?
  duration     Int?
  metadata     Json?
  createdAt    DateTime      @default(now())
  admins       admins?       @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([adminId])
  @@index([category])
  @@index([createdAt])
  @@index([resource])
}

model admin_sessions {
  id           String   @id
  adminId      Int
  sessionToken String   @unique
  refreshToken String   @unique
  device       String?
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  userAgent    String?
  isActive     Boolean  @default(true)
  totpVerified Boolean  @default(false)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  admins       admins   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@index([isActive])
  @@index([sessionToken])
}

model admins {
  id                                                     Int                @id @default(autoincrement())
  email                                                  String             @unique
  firstName                                              String
  lastName                                               String
  password                                               String
  role                                                   AdminRoleType      @default(SUPPORT)
  status                                                 AdminStatus        @default(ACTIVE)
  profileImage                                           String?
  phone                                                  String?
  phoneCountryCode                                       String?
  totpEnabled                                            Boolean            @default(false)
  totpSecret                                             String?
  totpVerifiedAt                                         DateTime?
  lastLogin                                              DateTime?
  lastLoginIp                                            String?
  lastLoginDevice                                        String?
  failedLoginAttempts                                    Int                @default(0)
  lockedUntil                                            DateTime?
  passwordChangedAt                                      DateTime?
  forcePasswordChange                                    Boolean            @default(false)
  ipWhitelist                                            Json?
  ipWhitelistEnabled                                     Boolean            @default(false)
  createdAt                                              DateTime           @default(now())
  updatedAt                                              DateTime
  createdBy                                              Int?
  admin_audit_logs                                       admin_audit_logs[]
  admin_sessions                                         admin_sessions[]
  escalation_cases_escalation_cases_assignedToIdToadmins escalation_cases[] @relation("escalation_cases_assignedToIdToadmins")
  escalation_cases_escalation_cases_createdByIdToadmins  escalation_cases[] @relation("escalation_cases_createdByIdToadmins")

  @@index([email])
  @@index([role])
  @@index([status])
}

model agent_assessments {
  id                  String    @id
  agentId             Int       @unique
  questionsAndAnswers Json
  totalQuestions      Int       @default(40)
  correctAnswers      Int       @default(0)
  score               Float     @default(0)
  isPassed            Boolean   @default(false)
  status              String    @default("pending")
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedBy          Int?
  reviewerNotes       String?
  attemptNumber       Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  users               users     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isPassed])
  @@index([status])
  @@index([submittedAt])
}

model agent_bookings {
  id                                   String   @id
  agentId                              Int
  clientId                             Int
  bookingType                          String
  bookingId                            String
  commission                           Float
  commissionRate                       Float
  status                               String   @default("active")
  notes                                String?
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime
  users_agent_bookings_agentIdTousers  users    @relation("agent_bookings_agentIdTousers", fields: [agentId], references: [id], onDelete: Cascade)
  users_agent_bookings_clientIdTousers users    @relation("agent_bookings_clientIdTousers", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([clientId])
}

model agent_commissions {
  id             String      @id
  agentId        Int
  propertyId     Int?
  bookingId      String
  amount         Float
  commissionRate Float
  status         String      @default("pending")
  earnedAt       DateTime?
  paidAt         DateTime?
  payoutMethod   String?
  transactionId  String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  users          users       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bookings       bookings    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  properties     properties? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([bookingId])
  @@index([propertyId])
  @@index([status])
}

model agent_performance_metrics {
  id              String   @id
  agentId         Int
  metricType      String
  value           Float
  unit            String?
  period          String
  periodStart     DateTime
  periodEnd       DateTime
  propertyCount   Int?
  clientCount     Int?
  bookingCount    Int?
  metadata        Json?
  marketAverage   Float?
  competitorRank  Int?
  improvementRate Float?
  calculatedAt    DateTime @default(now())
  updatedAt       DateTime
  users           users    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, metricType, period, periodStart])
  @@index([agentId])
  @@index([metricType])
  @@index([periodStart])
  @@index([period])
}

model agent_referrals {
  id             String    @id
  agentId        Int
  hostId         Int
  referralCode   String
  status         String    @default("pending")
  kycCompletedAt DateTime?
  verifiedAt     DateTime?
  bonusAwarded   Boolean   @default(false)
  bonusAwardedAt DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  agentName      String?

  @@unique([agentId, hostId])
  @@index([agentId])
  @@index([bonusAwarded])
  @@index([createdAt])
  @@index([hostId])
  @@index([status])
}

model agent_reviews {
  id                                  String    @id
  agentId                             Int
  clientId                            Int
  rating                              Int
  comment                             String?
  categories                          Json?
  bookingId                           String?
  serviceType                         String?
  communicationRating                 Int?
  professionalismRating               Int?
  knowledgeRating                     Int?
  responsivenessRating                Int?
  resultsRating                       Int?
  response                            String?
  responseDate                        DateTime?
  isVisible                           Boolean   @default(true)
  isReported                          Boolean   @default(false)
  createdAt                           DateTime  @default(now())
  updatedAt                           DateTime
  users_agent_reviews_agentIdTousers  users     @relation("agent_reviews_agentIdTousers", fields: [agentId], references: [id], onDelete: Cascade)
  users_agent_reviews_clientIdTousers users     @relation("agent_reviews_clientIdTousers", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([agentId, clientId, bookingId])
  @@index([agentId])
  @@index([clientId])
  @@index([createdAt])
  @@index([rating])
}

model audit_logs {
  id        String   @id
  userId    Int?
  action    String
  category  String?
  ipAddress String?
  userAgent String?
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

model automated_jobs {
  id             String    @id
  jobType        String
  schedule       String
  timezone       String    @default("Africa/Kigali")
  enabled        Boolean   @default(true)
  config         Json?
  lastRun        DateTime?
  lastRunStatus  String?
  nextRun        DateTime?
  executionCount Int       @default(0)
  successCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  @@index([enabled])
  @@index([jobType])
  @@index([nextRun])
}

model bank_accounts {
  id            String   @id
  userId        Int
  accountNumber String
  accountName   String
  bankCode      String
  bankName      String
  branchCode    String?
  isDefault     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  users         users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber, bankCode])
  @@index([userId])
}

model blocked_dates {
  id         String     @id
  propertyId Int
  startDate  DateTime
  endDate    DateTime
  reason     String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  properties properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([startDate, endDate])
}

model bonuses {
  id          String      @id
  userId      Int
  amount      Float
  currency    String      @default("RWF")
  sourceType  String
  sourceId    String
  propertyId  Int?
  description String?
  status      String      @default("pending")
  claimedAt   DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  properties  properties? @relation(fields: [propertyId], references: [id])
  users       users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sourceType])
  @@index([status])
  @@index([userId])
}

model booking_archive {
  id                 String    @id
  originalBookingId  String
  propertyId         Int
  propertyName       String
  propertyLocation   String
  guestId            Int
  guestName          String
  guestEmail         String
  guestPhone         String?
  checkIn            DateTime
  checkOut           DateTime
  guests             Int
  totalPrice         Float
  message            String?
  specialRequests    String?
  status             String
  paymentStatus      String
  bookingCreatedAt   DateTime
  archivedAt         DateTime  @default(now())
  archiveReason      String
  adminNotified      Boolean   @default(false)
  adminNotifiedAt    DateTime?
  adminNotes         String?
  leadStatus         String    @default("new")
  contactedAt        DateTime?
  convertedToBooking Boolean   @default(false)
  metadata           Json?

  @@index([adminNotified])
  @@index([archivedAt])
  @@index([guestId])
  @@index([leadStatus])
  @@index([originalBookingId])
  @@index([propertyId])
}

model bookings {
  id                         String              @id
  propertyId                 Int
  guestId                    Int
  checkIn                    DateTime
  checkOut                   DateTime
  guests                     Int
  totalPrice                 Float
  message                    String?
  status                     String              @default("pending")
  paymentStatus              String              @default("pending")
  paymentMethod              String?
  transactionId              String?
  notes                      String?
  specialRequests            String?
  checkInInstructions        String?
  checkOutInstructions       String?
  guestNotes                 String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime
  cancellationReason         String?
  cancelledAt                DateTime?
  checkInCode                String?
  checkInValidated           Boolean             @default(false)
  checkInValidatedAt         DateTime?
  checkInValidatedBy         Int?
  checkOutCode               String?
  checkOutValidated          Boolean             @default(false)
  checkOutValidatedAt        DateTime?
  checkOutValidatedBy        Int?
  ownerResponse              String?
  distributionAttempts       Int                 @default(0)
  distributionError          String?
  walletDistributed          Boolean             @default(false)
  walletDistributedAt        DateTime?
  payAtProperty              Boolean             @default(false)
  propertyPaymentAmount      Float?
  propertyPaymentCollected   Boolean             @default(false)
  propertyPaymentCollectedAt DateTime?
  propertyPaymentCollectedBy Int?
  bookingCode                String?             @unique
  refundAmount               Float?
  refundApproved             Boolean?
  refundApprovedAt           DateTime?
  refundApprovedBy           Int?
  refundChannel              String?
  refundCompletedAt          DateTime?
  refundPlatformFee          Float?
  refundRejected             Boolean?
  refundRejectedAt           DateTime?
  refundRejectedBy           Int?
  refundRejectionReason      String?
  refundRequested            Boolean             @default(false)
  refundRequestedAt          DateTime?
  refundRequestedBy          Int?
  refundToWallet             Boolean             @default(true)
  refundTransactionId        String?
  refundWalletCredited       Boolean             @default(false)
  refundWalletCreditedAt     DateTime?
  monthsCount                Int?
  nightsCount                Int?
  pricingType                String?
  agent_commissions          agent_commissions[]
  users                      users               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  properties                 properties          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  host_earnings              host_earnings?
  host_payments              host_payments[]
  owner_earnings             owner_earnings?
  owner_payments             owner_payments[]
  reviews                    reviews[]

  @@index([guestId])
  @@index([paymentStatus])
  @@index([propertyId])
  @@index([refundApproved])
  @@index([refundRequested])
  @@index([status])
}

model business_rules {
  id        String   @id
  category  String
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category])
}

model client_interactions {
  id                                        String    @id
  agentId                                   Int
  clientId                                  Int
  type                                      String
  duration                                  Int?
  outcome                                   String?
  nextAction                                String?
  dueDate                                   DateTime?
  propertyId                                Int?
  bookingId                                 String?
  notes                                     String?
  clientSatisfaction                        Int?
  agentNotes                                String?
  scheduledAt                               DateTime?
  completedAt                               DateTime?
  createdAt                                 DateTime  @default(now())
  updatedAt                                 DateTime
  users_client_interactions_agentIdTousers  users     @relation("client_interactions_agentIdTousers", fields: [agentId], references: [id], onDelete: Cascade)
  users_client_interactions_clientIdTousers users     @relation("client_interactions_clientIdTousers", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([clientId])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([type])
}

model communication_settings {
  id           String    @id
  enabled      Boolean   @default(false)
  provider     String
  config       Json
  dailyLimit   Int?
  currentUsage Int       @default(0)
  usageResetAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
}

model connected_accounts {
  id          String    @id
  userId      Int
  provider    String
  providerId  String
  email       String
  connected   Boolean   @default(true)
  connectedAt DateTime  @default(now())
  lastUsed    DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([connected])
  @@index([provider])
  @@index([userId])
}

model deal_code_usage {
  id                       Int                      @id @default(autoincrement())
  dealCodeId               Int
  propertyId               Int
  unlockId                 String
  usedAt                   DateTime                 @default(now())
  userId                   Int
  deal_codes               deal_codes               @relation(fields: [dealCodeId], references: [id], onDelete: Cascade)
  properties               properties               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  property_address_unlocks property_address_unlocks @relation(fields: [unlockId], references: [unlockId], onDelete: Cascade)
  users                    users                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dealCodeId])
  @@index([userId])
}

model deal_codes {
  id                       Int                        @id @default(autoincrement())
  code                     String                     @unique
  createdAt                DateTime                   @default(now())
  expiresAt                DateTime
  generatedAt              DateTime                   @default(now())
  isActive                 Boolean                    @default(true)
  remainingUnlocks         Int                        @default(5)
  sourcePropertyId         Int
  updatedAt                DateTime                   @default(now())
  userId                   Int
  deal_code_usage          deal_code_usage[]
  properties               properties                 @relation(fields: [sourcePropertyId], references: [id], onDelete: Cascade)
  users                    users                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property_address_unlocks property_address_unlocks[]

  @@index([code])
  @@index([expiresAt])
  @@index([userId, isActive])
}

model duplicate_detection_logs {
  id                                                    Int      @id @default(autoincrement())
  entityType                                            String
  entityId                                              String
  duplicateOfId                                         String
  similarityScore                                       Decimal  @db.Decimal(5, 2)
  similarityDetails                                     Json
  uploaderId                                            Int
  originalOwnerId                                       Int?
  status                                                String   @default("pending")
  adminNotified                                         Boolean  @default(false)
  uploaderNotified                                      Boolean  @default(false)
  ownerNotified                                         Boolean  @default(false)
  createdAt                                             DateTime @default(now())
  updatedAt                                             DateTime
  users_duplicate_detection_logs_originalOwnerIdTousers users?   @relation("duplicate_detection_logs_originalOwnerIdTousers", fields: [originalOwnerId], references: [id], onDelete: Cascade)
  users_duplicate_detection_logs_uploaderIdTousers      users    @relation("duplicate_detection_logs_uploaderIdTousers", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType])
  @@index([originalOwnerId])
  @@index([status])
  @@index([uploaderId])
}

model escalation_cases {
  id                                           String             @id
  createdById                                  Int
  assignedToId                                 Int?
  type                                         EscalationType
  priority                                     EscalationPriority @default(MEDIUM)
  status                                       EscalationStatus   @default(OPEN)
  title                                        String
  description                                  String
  resourceType                                 String?
  resourceId                                   String?
  resolution                                   String?
  resolvedAt                                   DateTime?
  createdAt                                    DateTime           @default(now())
  updatedAt                                    DateTime
  admins_escalation_cases_assignedToIdToadmins admins?            @relation("escalation_cases_assignedToIdToadmins", fields: [assignedToId], references: [id])
  admins_escalation_cases_createdByIdToadmins  admins             @relation("escalation_cases_createdByIdToadmins", fields: [createdById], references: [id])

  @@index([assignedToId])
  @@index([createdAt])
  @@index([createdById])
  @@index([priority])
  @@index([status])
  @@index([type])
}

model faqs {
  id          String   @id
  question    String
  answer      String
  category    String
  tags        Json?
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isPublished Boolean  @default(false)
  priority    Int      @default(0)

  @@index([category])
  @@index([isPublished])
  @@index([priority])
}

model help_articles {
  id          String    @id
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  category    String
  tags        Json?
  views       Int       @default(0)
  helpful     Int       @default(0)
  notHelpful  Int       @default(0)
  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  updatedBy   Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  createdBy   Int?

  @@index([category])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([slug])
}

model host_earnings {
  id          String     @id
  hostId      Int
  bookingId   String     @unique
  propertyId  Int
  grossAmount Float
  platformFee Float
  hostEarning Float
  currency    String     @default("USD")
  payoutId    String?
  status      String     @default("pending")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  earnedAt    DateTime?
  bookings    bookings   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  users       users      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  payouts     payouts?   @relation(fields: [payoutId], references: [id])
